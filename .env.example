# Impulse local configuration template.
# Copy to .env: cp .env.example .env
# Windows PowerShell: Copy-Item .env.example .env
#
# OpenRouter / AI Buddy:
# 1. Create your key at https://openrouter.ai/settings/keys
# 2. Put the real key in OPENROUTER_API_KEY in your local .env file only.
# 3. Change AI_BUDDY_ENABLED=true in your local .env to enable AI Buddy.
# Never commit real secrets; this template intentionally contains none.
#
APP_ENV=development
DEMO_MODE=true
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=
SESSION_SECRET=
# API key for server-side OpenRouter requests (never expose via VITE_*).
OPENROUTER_API_KEY=
# AI Buddy is opt-in; turn on only after providing OPENROUTER_API_KEY.
AI_BUDDY_ENABLED=false
AI_MENTOR_DRAFT_ENABLED=false
AI_OPERATOR_TRIAGE_ENABLED=false
AI_CUSTOMER_BRIEF_ENABLED=false
OPENROUTER_MODEL_BUDDY=openrouter/free
OPENROUTER_MODEL_STRUCTURED=openrouter/free
AI_MAX_REQUESTS_PER_USER_DAY=5
AI_MAX_TOOL_CALLS_PER_RUN=4
HONOR_BOARD_ENABLED=false
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_CONTENT_CAPTURE_ENABLED=false
